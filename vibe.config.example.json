{
  "claude": {
    "model": "opus",
    "effort": "medium",
    "planTimeoutMs": 1800000,
    "implementTimeoutMs": 5400000
  },
  "codex": {
    "model": "gpt-5.6-luna",
    "effort": "xhigh",
    "sandbox": "read-only",
    "timeoutMs": 2700000
  },
