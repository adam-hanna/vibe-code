    "escalateOnDefer": true,
    "escalateOnLowConfidence": true
  },
  "git": {
    "useBranch": true,
    "branchPrefix": "vibe/",
    "commitEachRound": true
  },
  "context": {
    "enabled": true,
    "compactAboveRatio": 0.5,
    "compactDuringCodex": true
  }
}
