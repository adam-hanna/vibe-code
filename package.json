{
  "name": "vibe-code",
  "version": "1.0.1",
  "description": "Automated plan/critique/implement/review loop between Claude Code and Codex.",
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "ai",
    "agent",
    "code-review",
    "automation",
    "cli"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adam-hanna/vibe-code.git"
  },
  "bugs": {
    "url": "https://github.com/adam-hanna/vibe-code/issues"
  },
  "homepage": "https://github.com/adam-hanna/vibe-code#readme",
  "bin": {
    "vibe": "dist/src/main.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && tsc-alias",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "doctor": "npm run build && node dist/src/main.js doctor"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsc-alias": "^1.9.1",
    "typescript": "^7.0.2"
  }
}
