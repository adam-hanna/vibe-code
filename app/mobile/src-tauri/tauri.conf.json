{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vibe",
  "version": "../../../package.json",
  "identifier": "dev.vibecode.mobile",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix .. run dev:mobile",
    "beforeBuildCommand": "npm --prefix .. run build:mobile"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Vibe" }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "android": { "minSdkVersion": 24 },
    "iOS": { "frameworks": ["SystemConfiguration"], "minimumSystemVersion": "15.0" }
  }
}
