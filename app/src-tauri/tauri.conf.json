{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vibe",
  "version": "../../package.json",
  "identifier": "dev.vibecode.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run stage:sidecar"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vibe",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "app", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/node"],
    "resources": ["host/**/*"],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE3MkMwQ0E0RjRGMjg2MkUKUldRdWh2TDBwQXdzRi91eTUvdjU4K05QS2tYUk9NRSs5VUZpU3cvejBEdmZvQzkvQVc1QnptRnAK",
      "endpoints": ["https://github.com/adam-hanna/vibe-code/releases/latest/download/latest.json"]
    }
  }
}
